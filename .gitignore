node_modules/
.next/
.env
.env.local
# Backups made before editing an env file hold the same secrets as the original.
.env.bak-*
.env.*.bak-*
# Client folders live only on local machines — each client gets its own GitHub repo.
# Keep the directory present on fresh clones via .gitkeep, but track nothing else.
/clients/*
!/clients/.gitkeep
console/export/
*.log
*.tsbuildinfo
**/.state/
.DS_Store

# Local Lighthouse runs (raw reports are large; see PERF.md for the record)
.perf/

# @jdd/ui lives in its own repo (JuneauDigitalDesigns/jdd-ui) and is consumed as a
# github: dependency. The working copy here is a clone for local development only —
# tracking it would embed a gitlink that clones of jdd-ops cannot resolve.
packages/ui/
