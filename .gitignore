node_modules/
.next/
.env
.env.local
# Backups made before editing an env file hold the same secrets as the original.
.env.bak-*
.env.*.bak-*
# Client folders live only on local machines — each client gets its own GitHub repo.
# Keep the directory present on fresh clones via .gitkeep, but track nothing else.
/clients/*
!/clients/.gitkeep
console/export/
*.log
# …except the dry-run recordings, which are FIXTURES rather than logs and are meant to be
# tracked. `*.log` swallowed them silently, so the phase contract had nothing to compare
# against on a fresh clone: every CI run failed `fixtures:dry-run:check` claiming "onboard.js's
# phase output drifted", which sends you hunting for a code regression that does not exist.
# They are portable by construction — scripts/record-dry-runs.js normalises the repo root,
# timings, agent/base ids, SIDs and phone numbers out of them before writing.
!test/fixtures/dry-run/*.log
*.tsbuildinfo
**/.state/
.DS_Store

# Local Lighthouse runs (raw reports are large; see PERF.md for the record)
.perf/

# `packages/ui/` is deliberately NOT ignored any more, and should not exist at all.
#
# @jdd/ui lives in its own repo (JuneauDigitalDesigns/jdd-ui) and is consumed as a `github:`
# dependency pinned by tag. A clone of it used to sit here for local development, ignored —
# and being ignored is what made it dangerous: it drifted from the published package in four
# files, including LeadForm.tsx and img.ts, while `git status` stayed clean and a comment in
# image-pipeline.ts told people to keep the pipeline in lockstep with the copy that does not
# ship. Editing the wrong one is a silent no-op you discover on a live client site.
#
# Without a rule here, any future clone shows up as untracked and is at least visible. Edit
# the package in its own repository.
