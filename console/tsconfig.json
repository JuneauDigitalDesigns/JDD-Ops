{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      // The template is the source of truth for code that ships to client repos. The console
      // imports from it rather than keeping a second copy — the previous hand-duplicated
      // JSON-LD in categories.tsx had already drifted from the component it mirrored.
      "@template/*": ["../template/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "../template/src/lib/structuredData.ts"],
  "exclude": ["node_modules"]
}
