{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      // The template is the source of truth for code that ships to client repos. The console
      // imports from it rather than keeping a second copy — the previous hand-duplicated
      // JSON-LD in categories.tsx had already drifted from the component it mirrored.
      "@template/*": ["../template/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "../template/src/lib/structuredData.ts", "../template/src/lib/StickyCallBar.tsx"],
  // lib-fixtures are INPUT to export-guard.test.mjs, not console source: they deliberately
  // contain an unresolvable star re-export and a re-export cycle, which are the two cases the
  // parser has to survive. Type-checking them would fail on exactly what they are there to test.
  "exclude": ["node_modules", "test/helpers/lib-fixtures/**"]
}
