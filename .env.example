# Anthropic
ANTHROPIC_API_KEY=

# Resend (master account, reused across every Starter client site for lead email delivery, not used for Growth or Enterprise clients)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Twilio — JDD master account. Used for number provisioning and inbound call routing.
# voiceUrl is set to https://{siteSlug}.vercel.app/api/voice (permanent; no update needed).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Retell — AI agents (numbers are now JDD-owned Twilio numbers, not Retell-managed).
RETELL_API_KEY=
RETELL_LLM_ID=
RETELL_DEFAULT_VOICE_ID=
# Post-call webhook is now set PER CLIENT: onboard.js clones the master post-call
# scenario and writes each clone's webhook into clients/{slug}/.env.local as
# RETELL_POST_CALL_WEBHOOK_URL. A master-level value here is optional/legacy.
RETELL_POST_CALL_WEBHOOK_URL=

# Airtable
AIRTABLE_API_KEY=
AIRTABLE_WORKSPACE_ID=

# GitHub (for creating per-client repos)
GITHUB_TOKEN=
GITHUB_ORG=

# Vercel — required for step 9 (sync env vars to client's deployed project so
# /api/contact has RETELL_API_KEY + TWILIO_NUMBER + RETELL_AGENT_ID for the
# direct Retell callback). Token: vercel.com/account/tokens.
# Team ID: vercel.com/{team}/~/settings → "Team ID" (only if using a team).
# The GitHub-Vercel integration must be authorized once at the org level so
# new client repos are auto-detected.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Make.com — used by step 8c to clone the post-call master scenario per client.
MAKE_API_KEY=
MAKE_POST_CALL_MASTER_SCENARIO_ID=

# A2P 10DLC Messaging Service (MG…) that holds the approved campaign + client local numbers.
# REQUIRED for any growth/enterprise client with SMS consent: onboard.js hard-fails without it
# (and verifies the campaign is approved), because a number outside this service fails every
# post-call text with error 30034. Twilio Console → Messaging → Services → your campaign's service.
TWILIO_MESSAGING_SERVICE_SID=

# Local number provisioning. We only ever buy LOCAL numbers — toll-free can't join A2P — and
# search geography-first: business-address ZIP → brand-phone area code → these defaults → region.
# Expanding beyond Florida later is just editing these two values.
TWILIO_DEFAULT_AREA_CODES=407,321,689
TWILIO_DEFAULT_REGION=FL

# Portal test login — used ONLY for test clients (_e2e* slugs or --test-portal) so you can
# sign into /portal without owning the client's brand.email inbox. Never used for real clients.
PORTAL_TEST_EMAIL=
PORTAL_TEST_PASSWORD=

# Portal ops bridge — /manage → Portal → "Billing vs plan".
#
# The console never writes to Stripe. It has no auth of any kind and runs on a restricted
# read-only Stripe key on purpose, so the one action that can re-price a subscription is made
# by the portal app instead: the console POSTs to PORTAL_BASE_URL/api/ops/plan-sync carrying
# this secret. Set OPS_SHARED_SECRET to the same value in the portal app's environment.
#
# Leave PORTAL_BASE_URL unset to use production, which is usually what you want — an ops action
# that moves money should act on the real subscription, not on whatever is running locally.
OPS_SHARED_SECRET=
PORTAL_BASE_URL=

# Go-live automation (console /go-live route) — each pair is optional; the step it powers
# falls back to a manual dashboard link (with dry-run preview) when its keys are unset.
# (Upstash Redis is provisioned through the Vercel → Storage → Upstash integration, which
# injects its env vars onto the project — no key belongs here for it.)
#
# Cloudflare API token (Account › Turnstile › Edit) + account ID (dashboard → Account Home).
# Creates the production Turnstile widget bound to juneaudigitaldesigns.com.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# TURNSTILE_WIDGET_NAME=JDD production  # override the widget name the run matches/creates by
#
# Stripe live secret key — ALSO used by the "create live prices" step (see STRIPE_SECRET_KEY /
# STRIPE_TEST_SECRET_KEY below). Reused here to create the live webhook endpoint at
# /api/webhooks/stripe with exactly the events that handler branches on. One-time: add for the
# go-live run, remove after.
STRIPE_LIVE_SECRET_KEY=

# Stripe — read-only from this repo (audit-billing.js plan-drift detection) plus the source
# for "create the live Stripe prices" (see above). STRIPE_SECRET_KEY is the day-to-day key;
# set STRIPE_TEST_SECRET_KEY separately only if STRIPE_SECRET_KEY itself isn't a test key.
STRIPE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ONBOARDING=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=

# Stripe read key — /manage → Portal lookup, and the /finances income totals.
#
# STRIPE_READONLY_KEY is strongly preferred over STRIPE_SECRET_KEY: this console has no auth of
# any kind, and nothing in it ever needs to write to Stripe. Falls back to STRIPE_SECRET_KEY
# only if the read-only key is absent.
#
# Restricted-key permissions needed:
#   customers:read             — /manage → Portal subscription lookup
#   subscriptions:read         — /manage → Portal subscription lookup
#   balance_transaction:read   — /finances income + Stripe fee totals
#
# Without balance_transaction:read the Finances page still loads, but income reads $0 and the
# page says which permission is missing.
STRIPE_READONLY_KEY=

# Template source — DEPRECATED & UNUSED. Onboarding is local-first: the blank template lives
# in this repo at template/ and is copied per client into clients/{slug}/repo (studio Export or
# `npm run new-client`). onboard.js no longer clones a GitHub template. Leave blank.
TEMPLATE_REPO=
