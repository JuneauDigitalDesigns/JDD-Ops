{
  "name": "jdd-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Juneau Digital Designs ops repo — provisioning orchestrator for per-client Next.js + Retell + Twilio + Airtable stacks. Never deployed.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "onboard": "node onboard.js",
    "link-portal": "node onboard.js --link-portal",
    "new-client": "node scripts/new-client.js",
    "hydrate": "node scripts/hydrate.js",
    "update-prompt": "node scripts/update-agent-prompt.js",
    "sync-env": "node scripts/sync-vercel-env.js",
    "repair-portal": "node scripts/repair-portal-sites.js",
    "audit-analytics": "node scripts/audit-analytics.js",
    "audit-billing": "node scripts/audit-billing.js",
    "backfill-agent-limits": "node scripts/backfill-agent-limits.js",
    "backfill-agent-ids": "node scripts/backfill-account-agent-ids.js",
    "backfill-client-records": "node scripts/backfill-client-records.js",
    "teardown": "node scripts/teardown.js",
    "check-schema": "cd console && npm run check-schema",
    "console": "cd console && npm install && npm run dev",
    "preview": "cd console && npm install && npm run dev",
    "runbook": "cd console && npm install && npm run dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@clerk/backend": "^3.5.0",
    "@jdd/schema": "github:JuneauDigitalDesigns/jdd-schema#v1.12.0",
    "@octokit/rest": "^21.0.2",
    "@upstash/redis": "^1.38.0",
    "airtable": "^0.12.2",
    "dotenv": "^16.4.5",
    "twilio": "^5.3.5"
  }
}
