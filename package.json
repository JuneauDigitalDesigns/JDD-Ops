{
  "name": "jdd-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Juneau Digital Designs ops repo — provisioning orchestrator for per-client Next.js + Retell + Twilio + Airtable stacks. Never deployed.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "onboard": "node onboard.js",
    "link-portal": "node onboard.js --link-portal",
    "new-client": "node scripts/new-client.js",
    "hydrate": "node scripts/hydrate.js",
    "update-prompt": "node scripts/update-agent-prompt.js",
    "regenerate-prompt": "node scripts/regenerate-prompt.js",
    "sync-env": "node scripts/sync-vercel-env.js",
    "repair-portal": "node scripts/repair-portal-sites.js",
    "audit-analytics": "node scripts/audit-analytics.js",
    "test": "node --test \"test/**/*.test.mjs\"",
    "fixtures:refresh": "node scripts/refresh-fixtures.js",
    "fixtures:check": "node scripts/refresh-fixtures.js --check",
    "fixtures:a2p": "node scripts/record-a2p-fixtures.js",
    "fixtures:dry-run": "node scripts/record-dry-runs.js",
    "fixtures:dry-run:check": "node scripts/record-dry-runs.js --check",
    "setup-hooks": "git config core.hooksPath .githooks",
    "verify-make": "node scripts/verify-make.js",
    "verify-post-call": "node scripts/verify-post-call.js",
    "repatch-post-call": "node scripts/repatch-post-call.js",
    "verify-agents": "node scripts/verify-agents.js",
    "audit-billing": "node scripts/audit-billing.js",
    "backfill-agent-limits": "node scripts/backfill-agent-limits.js",
    "backfill-agent-ids": "node scripts/backfill-account-agent-ids.js",
    "backfill-client-records": "node scripts/backfill-client-records.js",
    "teardown": "node scripts/teardown.js",
    "unlink-external-client": "node scripts/unlink-external-client.js",
    "check-schema": "cd console && npm run check-schema",
    "console": "cd console && npm install && npm run dev",
    "preview": "cd console && npm install && npm run dev",
    "runbook": "cd console && npm install && npm run dev",
    "repair-call-log": "node scripts/repair-call-log.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@clerk/backend": "^3.5.0",
    "@jdd/schema": "github:JuneauDigitalDesigns/jdd-schema#v1.32.0",
    "@octokit/rest": "^21.0.2",
    "@upstash/redis": "^1.38.0",
    "airtable": "^0.12.2",
    "dotenv": "^16.4.5",
    "twilio": "^5.3.5"
  }
}
